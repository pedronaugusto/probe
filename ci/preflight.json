{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**",
    "src/**/*_test.zig"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "shipped": {},
